  "dictionary": {
    "YR": {
      "CODE": "YR",
      "Variable Name": "Year",
      "Description": "Calendar year of observation (2010–2025)",
      "Source Sheet": "All Sheets",
      "Data Source": "Surveillance / NASA / DOH / OpenDengue",
      "Unit of Measurement": "Year (integer)"
    },
    "WN": {
      "CODE": "WN",
      "Variable Name": "Week Number",
      "Description": "ISO epidemiological week number (1–52 or 1–53). Integer type in all sheets.",
      "Source Sheet": "All Sheets",
      "Data Source": "Derived from source dates",
      "Unit of Measurement": "Integer (1–53)"
    },
    "DC_QC": {
      "CODE": "DC_QC",
      "Variable Name": "Dengue Cases, QC",
      "Description": "Weekly confirmed and probable dengue cases reported in Quezon City (QCESD/PIDSR).",
      "Source Sheet": "QC Data",
      "Data Source": "QCESD via PIDSR surveillance system",
      "Unit of Measurement": "Count (integer)"
    },
    "RF_NASA": {
      "CODE": "RF_NASA",
      "Variable Name": "Rainfall, NASA IMERG",
      "Description": "Weekly total rainfall (mm) from NASA GPM IMERG Final Run v07. For QC Data: single 0.1°×0.1° centroid cell. For Multi-Setting Data: setting-wide area-weighted mean across all land cells.",
      "Source Sheet": "QC Data, Multi-Setting Data",
      "Data Source": "NASA GES DISC GPM_3IMERGDF v07",
      "Unit of Measurement": "mm per week (float)"
    },
    "Temp_ERA5-Land": {
      "CODE": "Temp_ERA5-Land",
      "Variable Name": "Temperature, ERA5-Land (mean)",
      "Description": "Weekly mean of daily mean 2 m air temperature from the ERA5-Land reanalysis. QC Data uses a single grid-cell extraction at the city centroid, pulled through the Open-Meteo Historical Weather API. Regional and Multi-Setting Data use area-weighted spatial averages for each administrative region or setting.",
      "Source Sheet": "QC Data, Regional Data, Multi-Setting Data",
      "Data Source": "ERA5-Land reanalysis (Copernicus C3S)",
      "Unit of Measurement": "degrees Celsius (float)"
    },
    "FLAG_COVID": {
      "CODE": "FLAG_COVID",
      "Variable Name": "Flag: COVID Period",
      "Description": "1 = record falls in 2020–2021 for QC Data; reflects potential under-reporting and genuine transmission reduction during the COVID-19 pandemic. 0 = no flag.",
      "Source Sheet": "QC Data",
      "Data Source": "Derived",
      "Unit of Measurement": "Binary (0/1)"
    }
  },
  "calendar_evidence": {
    "summary": "All new columns follow the same YR/WN convention already used for RF_NASA, RF_HDX and RF_PAGASA: continuous 7-day blocks counted from 2010-01-01, with the rare 53rd block of a year folded into WN 52.",
    "dictionary": "ISO epidemiological week number (1–52 or 1–53). Integer type in all sheets.",
    "resolution": "Retain original YR/WN order; no actual start/end dates inferred",
    "validation_script_lines": [
      "    \"The Data Dictionary calls WN ISO week, while Dataset Summary describes continuous 7-day blocks with rare 53rd blocks folded into WN 52.\",",
      "    \"Workbook convention is 52 weekly blocks, not ISO-week validation.\","
    ]
  },
